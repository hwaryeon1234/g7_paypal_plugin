{
    "identifier": "g7plus-paypal",
    "vendor": "g7plus",
    "name": {
        "ko": "페이팔",
        "en": "PayPal"
    },
    "version": "2.1.0",
    "license": "MIT",
    "description": {
        "ko": "해외 고객용 PayPal 결제 (Orders v2 · 외화 결제 · 부분환불 · 웹훅 서명 검증)",
        "en": "PayPal checkout for international customers (Orders v2, foreign currencies, partial refunds, signed webhooks)"
    },
    "g7_version": ">=7.1.1",
    "dependencies": {
        "modules": {
            "sirsoft-ecommerce": ">=1.3.0"
        },
        "plugins": {}
    },
    "github_url": "https://github.com/hwaryeon1234/g7_paypal_plugin",
    "github_changelog_url": "https://github.com/hwaryeon1234/g7_paypal_plugin/blob/main/CHANGELOG.md",
    "assets": {
        "js": {
            "entry": "resources/js/index.ts",
            "output": "dist/js/plugin.iife.js"
        },
        "css": {
            "entry": "resources/css/main.css",
            "output": "dist/css/plugin.css"
        },
        "handlers": true
    },
    "loading": {
        "strategy": "global",
        "priority": 100
    }
}
