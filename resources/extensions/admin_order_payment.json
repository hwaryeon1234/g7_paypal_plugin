{
    "comment": "관리자 주문 상세에 PayPal 거래 정보 패널을 덧붙인다. PayPal 캡처 ID(거래 ID)는 PayPal 대시보드에서 거래를 찾을 때 쓰는 값이라 코어 주문 화면이 알 수 없다",
    "target_layout": "admin_ecommerce_order_detail",
    "data_sources": [
        {
            "id": "paypalOrderPayment",
            "label_key": "$t:g7plus-paypal.editor.data_source.paypalOrderPayment",
            "type": "api",
            "endpoint": "/api/plugins/g7plus-paypal/admin/orders/{{route.orderNumber}}/payment",
            "method": "GET",
            "auto_fetch": true,
            "auth_required": true,
            "loading_strategy": "progressive",
            "comment": "PayPal 수수료·판매자 보호·환불/차지백 기록 — 이커머스 주문 API 가 내보내지 않는 payment_meta 를 플러그인 API 로 읽는다"
        }
    ],
    "injections": [
        {
            "target_id": "tab_content_area",
            "position": "append_child",
            "components": [
                {
                    "id": "paypal_payment_panel",
                    "type": "basic",
                    "name": "Div",
                    "if": "{{(order.data?.payments?.filter(p => p.pg_provider === 'paypal' && p.transaction_id) ?? []).length > 0}}",
                    "props": {
                        "className": "admin-card"
                    },
                    "children": [
                        {
                            "id": "paypal_payment_header",
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "flex items-center gap-2 mb-4"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "className": "w-1.5 h-4 bg-blue-900 rounded-full flex-shrink-0"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "H3",
                                    "props": {
                                        "className": "text-sm font-semibold text-gray-800 dark:text-gray-200"
                                    },
                                    "text": "$t:g7plus-paypal.admin.payment_panel_title"
                                }
                            ]
                        },
                        {
                            "id": "paypal_payment_rows",
                            "type": "basic",
                            "name": "Div",
                            "props": {
                                "className": "space-y-2"
                            },
                            "children": [
                                {
                                    "id": "paypal_mode_row",
                                    "type": "basic",
                                    "name": "Div",
                                    "if": "{{!!paypalOrderPayment.data?.mode}}",
                                    "props": {
                                        "className": "flex-between text-sm"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-sm text-gray-500 dark:text-gray-400"
                                            },
                                            "text": "$t:g7plus-paypal.admin.mode"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-gray-900 dark:text-white"
                                            },
                                            "text": "{{paypalOrderPayment.data?.mode === 'sandbox' ? $t('g7plus-paypal.admin.mode_sandbox') : $t('g7plus-paypal.admin.mode_live')}}"
                                        }
                                    ]
                                },
                                {
                                    "id": "paypal_order_id_row",
                                    "type": "basic",
                                    "name": "Div",
                                    "if": "{{!!paypalOrderPayment.data?.paypal_order_id}}",
                                    "props": {
                                        "className": "flex-between text-sm"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-sm text-gray-500 dark:text-gray-400"
                                            },
                                            "text": "$t:g7plus-paypal.admin.paypal_order_id"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "font-mono text-gray-900 dark:text-white"
                                            },
                                            "text": "{{paypalOrderPayment.data?.paypal_order_id ?? ''}}"
                                        }
                                    ]
                                },
                                {
                                    "id": "paypal_capture_status_row",
                                    "type": "basic",
                                    "name": "Div",
                                    "if": "{{!!paypalOrderPayment.data?.capture_status}}",
                                    "props": {
                                        "className": "flex-between text-sm"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-sm text-gray-500 dark:text-gray-400"
                                            },
                                            "text": "$t:g7plus-paypal.admin.capture_status"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-gray-900 dark:text-white"
                                            },
                                            "text": "{{paypalOrderPayment.data?.capture_status ?? ''}}"
                                        }
                                    ]
                                },
                                {
                                    "id": "paypal_capture_id_row",
                                    "type": "basic",
                                    "name": "Div",
                                    "if": "{{!!order.data?.payment?.transaction_id}}",
                                    "props": {
                                        "className": "flex-between text-sm"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-sm text-gray-500 dark:text-gray-400"
                                            },
                                            "text": "$t:g7plus-paypal.admin.capture_id"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "font-mono text-gray-900 dark:text-white"
                                            },
                                            "text": "{{order.data?.payment?.transaction_id ?? ''}}"
                                        }
                                    ]
                                },
                                {
                                    "id": "paypal_funding_row",
                                    "type": "basic",
                                    "name": "Div",
                                    "if": "{{!!order.data?.payment?.card_name}}",
                                    "props": {
                                        "className": "flex-between text-sm"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-sm text-gray-500 dark:text-gray-400"
                                            },
                                            "text": "$t:g7plus-paypal.admin.funding_source"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-gray-900 dark:text-white"
                                            },
                                            "text": "{{(order.data?.payment?.card_name ?? '') + (order.data?.payment?.card_number_masked ? ' ' + order.data.payment.card_number_masked : '')}}"
                                        }
                                    ]
                                },
                                {
                                    "id": "paypal_currency_row",
                                    "type": "basic",
                                    "name": "Div",
                                    "props": {
                                        "className": "flex-between text-sm"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-sm text-gray-500 dark:text-gray-400"
                                            },
                                            "text": "$t:g7plus-paypal.admin.charged"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-gray-900 dark:text-white font-medium"
                                            },
                                            "text": "{{order.data?.payment?.paid_amount_formatted ?? ''}}"
                                        }
                                    ]
                                },
                                {
                                    "id": "paypal_fee_row",
                                    "type": "basic",
                                    "name": "Div",
                                    "if": "{{!!paypalOrderPayment.data?.fee}}",
                                    "props": {
                                        "className": "flex-between text-sm"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-sm text-gray-500 dark:text-gray-400"
                                            },
                                            "text": "$t:g7plus-paypal.admin.fee"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-gray-900 dark:text-white"
                                            },
                                            "text": "{{paypalOrderPayment.data?.fee ?? ''}}"
                                        }
                                    ]
                                },
                                {
                                    "id": "paypal_net_row",
                                    "type": "basic",
                                    "name": "Div",
                                    "if": "{{!!paypalOrderPayment.data?.net}}",
                                    "props": {
                                        "className": "flex-between text-sm"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-sm text-gray-500 dark:text-gray-400"
                                            },
                                            "text": "$t:g7plus-paypal.admin.net"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-gray-900 dark:text-white font-medium"
                                            },
                                            "text": "{{paypalOrderPayment.data?.net ?? ''}}"
                                        }
                                    ]
                                },
                                {
                                    "id": "paypal_protection_row",
                                    "type": "basic",
                                    "name": "Div",
                                    "if": "{{!!paypalOrderPayment.data?.seller_protection}}",
                                    "props": {
                                        "className": "flex-between text-sm"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-sm text-gray-500 dark:text-gray-400"
                                            },
                                            "text": "$t:g7plus-paypal.admin.seller_protection"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-gray-900 dark:text-white"
                                            },
                                            "text": "{{paypalOrderPayment.data?.seller_protection ?? ''}}"
                                        }
                                    ]
                                },
                                {
                                    "id": "paypal_payer_row",
                                    "type": "basic",
                                    "name": "Div",
                                    "if": "{{!!paypalOrderPayment.data?.payer_email}}",
                                    "props": {
                                        "className": "flex-between text-sm"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-sm text-gray-500 dark:text-gray-400"
                                            },
                                            "text": "$t:g7plus-paypal.admin.payer"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Span",
                                            "props": {
                                                "className": "text-gray-900 dark:text-white"
                                            },
                                            "text": "{{(paypalOrderPayment.data?.payer_email ?? '') + (paypalOrderPayment.data?.payer_country ? ' (' + paypalOrderPayment.data.payer_country + ')' : '')}}"
                                        }
                                    ]
                                },
                                {
                                    "id": "paypal_pending_notice",
                                    "type": "basic",
                                    "name": "P",
                                    "if": "{{paypalOrderPayment.data?.capture_status === 'PENDING'}}",
                                    "props": {
                                        "className": "text-xs text-amber-700 dark:text-amber-400 pt-1"
                                    },
                                    "text": "$t:g7plus-paypal.admin.pending_notice"
                                },
                                {
                                    "id": "paypal_events",
                                    "type": "basic",
                                    "name": "Div",
                                    "if": "{{(paypalOrderPayment.data?.events ?? []).length > 0}}",
                                    "props": {
                                        "className": "pt-3 border-t border-gray-100 dark:border-gray-700 space-y-1"
                                    },
                                    "children": [
                                        {
                                            "type": "basic",
                                            "name": "P",
                                            "props": {
                                                "className": "text-xs font-semibold text-gray-700 dark:text-gray-300"
                                            },
                                            "text": "$t:g7plus-paypal.admin.events_title"
                                        },
                                        {
                                            "type": "basic",
                                            "name": "Div",
                                            "iteration": {
                                                "source": "{{paypalOrderPayment.data?.events ?? []}}",
                                                "item_var": "ppEvent",
                                                "index_var": "ppEventIdx"
                                            },
                                            "props": {
                                                "className": "flex-between text-xs"
                                            },
                                            "children": [
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "props": {
                                                        "className": "text-gray-600 dark:text-gray-400"
                                                    },
                                                    "text": "{{(ppEvent.type === 'PAYMENT.CAPTURE.REVERSED' ? $t('g7plus-paypal.admin.event_reversed') : $t('g7plus-paypal.admin.event_refunded')) + ' · ' + (ppEvent.received_at ?? '').slice(0, 16).replace('T', ' ')}}"
                                                },
                                                {
                                                    "type": "basic",
                                                    "name": "Span",
                                                    "props": {
                                                        "className": "text-gray-900 dark:text-white"
                                                    },
                                                    "text": "{{(ppEvent.amount ?? '') + (ppEvent.status ? ' · ' + ppEvent.status : '')}}"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "paypal_dashboard_link",
                                    "type": "basic",
                                    "name": "A",
                                    "if": "{{!!paypalOrderPayment.data?.dashboard_url}}",
                                    "props": {
                                        "href": "{{paypalOrderPayment.data?.dashboard_url}}",
                                        "target": "_blank",
                                        "rel": "noopener noreferrer",
                                        "className": "inline-block text-xs text-blue-600 dark:text-blue-400 underline pt-2"
                                    },
                                    "text": "$t:g7plus-paypal.admin.open_dashboard"
                                },
                                {
                                    "type": "basic",
                                    "name": "P",
                                    "props": {
                                        "className": "text-xs text-gray-500 dark:text-gray-400 pt-2"
                                    },
                                    "text": "$t:g7plus-paypal.admin.dashboard_hint"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
